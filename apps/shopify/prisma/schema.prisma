// Prisma Schema for cornerKit Shopify App
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Development: SQLite (file-based, zero configuration)
// Production: Change to postgresql and update DATABASE_URL
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Shopify session storage
/// Managed by @shopify/shopify-app-session-storage-prisma
/// Schema must match: https://github.com/Shopify/shopify-app-js/tree/main/packages/apps/session-storage/shopify-app-session-storage-prisma
model Session {
  /// Unique session identifier
  id            String    @id

  /// Shopify store domain (e.g., "store.myshopify.com")
  shop          String

  /// OAuth state parameter for CSRF protection
  state         String

  /// True = online access token, False = offline
  isOnline      Boolean   @default(false)

  /// Comma-separated OAuth scopes granted
  scope         String?

  /// Token expiration timestamp
  expires       DateTime?

  /// Shopify API access token
  accessToken   String?

  /// Shopify user ID (only for online sessions)
  userId        BigInt?

  /// User first name (online sessions)
  firstName     String?

  /// User last name (online sessions)
  lastName      String?

  /// User email (online sessions)
  email         String?

  /// Whether user is account owner
  accountOwner  Boolean   @default(false)

  /// User locale
  locale        String?

  /// Whether user is a collaborator
  collaborator  Boolean?  @default(false)

  /// Whether email is verified
  emailVerified Boolean?  @default(false)

  /// Index for efficient shop lookups
  @@index([shop])
}
