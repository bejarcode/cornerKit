{
  "name": "@cornerkit/svelte",
  "version": "1.0.0",
  "description": "Svelte components and actions for iOS-style squircle corners",
  "type": "module",
  "main": "dist/cornerkit-svelte.js",
  "module": "dist/cornerkit-svelte.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/cornerkit-svelte.esm.js",
      "import": "./dist/cornerkit-svelte.esm.js",
      "require": "./dist/cornerkit-svelte.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src --ext .ts,.svelte",
    "clean": "rm -rf dist",
    "package": "svelte-kit sync && svelte-package -o dist"
  },
  "peerDependencies": {
    "@cornerkit/core": "^1.1.0",
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@testing-library/svelte": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "happy-dom": "^12.10.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "svelte",
    "svelte3",
    "svelte4",
    "svelte5",
    "squircle",
    "superellipse",
    "border-radius",
    "ios",
    "corners",
    "ui",
    "component",
    "action"
  ],
  "author": "cornerKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bejarcode/cornerKit.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/bejarcode/cornerKit/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/bejarcode/cornerKit/issues"
  }
}
