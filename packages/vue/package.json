{
  "name": "@cornerkit/vue",
  "version": "1.0.0",
  "description": "Vue 3 components, composables, and directives for iOS-style squircle corners",
  "type": "module",
  "main": "dist/cornerkit-vue.js",
  "module": "dist/cornerkit-vue.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/cornerkit-vue.esm.js",
      "require": "./dist/cornerkit-vue.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@cornerkit/core": "^1.1.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/server-renderer": "^3.4.0",
    "@vue/test-utils": "^2.4.0",
    "@vitest/coverage-v8": "^1.6.1",
    "happy-dom": "^12.10.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.0.0",
    "vue": "^3.4.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "squircle",
    "superellipse",
    "border-radius",
    "ios",
    "corners",
    "ui",
    "component",
    "composable",
    "directive"
  ],
  "author": "cornerKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bejarcode/cornerKit.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/bejarcode/cornerKit/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/bejarcode/cornerKit/issues"
  }
}
